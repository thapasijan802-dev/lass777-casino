# Environment Variables for Lass777 Casino Backend

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/casino_db?schema=public"

# Redis Cache & Sessions (Optional - in-memory fallback enabled automatically if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret for Player and Admin tokens
JWT_SECRET="lass777-super-secret-production-key-999-secure-seed"

# Active Game Aggregator Adapter: MOCK | SOFTSWISS | SLOTEGRATOR
ACTIVE_AGGREGATOR=MOCK

# Aggregator Webhook & Signature Keys (for production integration)
AGGREGATOR_WEBHOOK_SECRET=your_aggregator_webhook_secret_here

# SoftSwiss Casino Aggregator Credentials (if ACTIVE_AGGREGATOR=SOFTSWISS)
SOFTSWISS_API_URL=https://api.softswiss.net/api/v2
SOFTSWISS_CASINO_ID=your_softswiss_casino_id
SOFTSWISS_AUTH_KEY=your_softswiss_auth_key

# Slotegrator Merchant Credentials (if ACTIVE_AGGREGATOR=SLOTEGRATOR)
SLOTEGRATOR_API_URL=https://api.slotegrator.com/v1
SLOTEGRATOR_MERCHANT_ID=your_slotegrator_merchant_id
SLOTEGRATOR_MERCHANT_KEY=your_slotegrator_merchant_key
